# Run npm run setup to generate a private .env with unique credentials.
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Set a password with at least 12 characters. Never commit .env.
APP_PASSWORD=
# Exactly 64 hexadecimal characters (32 random bytes). Generated by setup.
ENCRYPTION_KEY=
# Machine credential for compatible custom MCP clients. Generated by setup.
# Treat this like a password: it authorizes account actions, including ad changes.
PIPELINE_API_KEY=
DATA_DIR=./data

# Only configure the platforms you use. Restart after changing these.
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_ADS_ACCOUNT_ID=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional bot-only channel permissions for Discord actions:
DISCORD_BOT_TOKEN=
# Optional manual configuration; the dashboard can save these without editing this file.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
# Optional approved LinkedIn member-read API:
LINKEDIN_ENABLE_MEMBER_READ=false
LINKEDIN_ENABLE_ORGANIZATIONS=false
LINKEDIN_ENABLE_CONVERSIONS=false
# Optional action-specific conversion tokens:
REDDIT_CONVERSIONS_TOKEN=
TIKTOK_EVENTS_ACCESS_TOKEN=
# Optional local xAI API client, separate from Grok Bot; MCP usage does not use this model.
XAI_MODEL=grok-4
